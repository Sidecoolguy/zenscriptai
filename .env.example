# ZenScriptsAI backend configuration
# Copy to `.env` and fill in (the server loads .env automatically if present).

# Required — an OpenAI-compatible API key (OpenAI, OpenRouter, Groq, DeepSeek, ...)
LLM_API_KEY=sk-your-key-here

# Optional — endpoint and model (defaults shown)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional — server port
# PORT=3000

# Premium payments (Stripe Checkout)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# SITE_URL=http://localhost:3000
# PREMIUM_CODES=TEST-ABC,LAUNCH-2024

# Accounts — where user data is stored (defaults to ./data)
# DATA_DIR=./data
